# PostgreSQL connection string used by Drizzle (node-postgres / pg driver).
# The Python backend previously defaulted to a local SQLite file; the Node/Drizzle
# layer targets PostgreSQL to match the COG-GTM/Cloudscape-Dashboard setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Optional: port for the minimal Express scaffold that hosts the DB layer.
PORT=8000
